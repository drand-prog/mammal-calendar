# The shared admin password. Anyone with this can edit site text, FAQs, and
# order->month assignments. Set the real value in Vercel's project settings
# -> Environment Variables, never commit it here.
ADMIN_PASSWORD=

# A GitHub fine-grained personal access token, scoped to ONLY this repo,
# with "Contents: Read and write" permission. Used server-side (never sent
# to the browser) so the admin API can commit edits back to data/reptile/*.json.
# Create one at https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=

# Repo the admin API commits to -- the SAME repo as the mammal and bird apps
# (both separate products);
# the reptile/amphibian product just lives in its own data/reptile/ and
# apps/reptile-*/ folders within it. Defaults match this repo; only change
# these if you fork it elsewhere.
GITHUB_REPO_OWNER=drand-prog
GITHUB_REPO_NAME=mammal-calendar
GITHUB_REPO_BRANCH=main
