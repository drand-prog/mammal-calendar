# The shared admin password. Anyone with this can add/edit/remove FAQs.
# Set the real value in Vercel's project settings -> Environment Variables,
# never commit it here.
ADMIN_PASSWORD=

# A GitHub fine-grained personal access token, scoped to ONLY this repo,
# with "Contents: Read and write" permission. Used server-side (never sent
# to the browser) so the admin API can commit FAQ edits back to data/faqs.json.
# Create one at https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=

# Repo the admin API commits to. Defaults match this repo; only change these
# if you fork it elsewhere.
GITHUB_REPO_OWNER=drand-prog
GITHUB_REPO_NAME=mammal-calendar
GITHUB_REPO_BRANCH=main
